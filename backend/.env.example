# ── Backend environment ───────────────────────────────────────────────
# Copy this file to  backend/.env  and fill in the real values.
# NEVER commit the real .env (it is git-ignored).

# Database — shared team MS SQL Server on the course RDS host
DB_HOST=your-db-host.rds.amazonaws.com
DB_PORT=1433
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=s3988312
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
# Auto-creates tables from the entities in dev. Set to false once the schema is stable.
DB_SYNCHRONIZE=true

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000
